{
  "name": "chill-sessions-bot-backend",
  "version": "1.0.0",
  "description": "Backend API for AI-powered Gen Z therapy bot",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "openai": "^4.20.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "compression": "^1.7.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "supertest": "^7.0.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.12.2",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
