# ─── Server ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# ─── AI provider (one of: groq | openai | huggingface | ollama) ──────────
AI_PROVIDER=groq

# Required key depends on AI_PROVIDER (validated at startup):
#   groq         → GROQ_API_KEY (gsk_…, get one at https://console.groq.com/keys)
#   openai       → OPENAI_API_KEY
#   huggingface  → HUGGINGFACE_API_KEY
#   ollama       → OLLAMA_URL (defaults to http://localhost:11434)
GROQ_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_URL=http://localhost:11434

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_PATH=./data/conversations.db

# ─── Rate limiting (per-IP) ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ─────────────────────────────────────────────────────────────
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
